DEBUG=True
SECRET_KEY=change-me-in-production-use-a-long-random-string
DATABASE_URL=postgresql://truelinks:holora@localhost:5432/truelinks_db
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend base URL — used to build invitation / password-reset email links
FRONTEND_URL=http://localhost:5173

# AI provider: 'mock' (no external deps), 'ollama' (local), or 'openai' (your API)
AI_PROVIDER=mock

# -- 'ollama': local AI. Requires: ollama serve + ollama pull llama3.2 + ollama pull llava:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Vision model for inspection image analysis — pull with: ollama pull llava:7b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_VISION_TIMEOUT=120

# -- 'openai': any OpenAI-compatible chat-completions API (OpenAI, Groq,
#    Together, Azure, or Ollama's own /v1). Needs a model that returns JSON,
#    and a vision-capable model for inspections.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

MAX_UPLOAD_SIZE_MB=20
MEDIA_ROOT=media

# Email — defaults to console backend (emails printed to the server log).
# For real SMTP delivery set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@truelinks.local
